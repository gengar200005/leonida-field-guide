  "p09-m-082": {
    "title": "포트 겔혼에서 머리 바꾸기",
    "summary": "포트 겔혼의 미용실에서 루시아의 헤어스타일 한 가지를 실제로 구입하면 끝나는 외형 과제입니다.",
    "replaceSections": {
      "보존·마감": {
        "title": "시작 시점과 위치",
        "paragraphs": [
