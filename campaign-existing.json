  "p09-m-080": {
    "title": "덩크의 진통제 연락 기다리기",
    "summary": "덩크에게 공급책 소식을 듣기까지 기다리는 연락 과제입니다. 겔혼에서 남은 심부름을 하면서 다음 트레일러 표식을 여세요.",
    "replaceSections": {
      "보존·마감": {
        "title": "시작 시점과 위치",
        "paragraphs": [
          "비키의 외출 의뢰 뒤 지도 내 스토리 목록에 추가됩니다. 특정 집을 방문하는 과제는 아닙니다."
        ]
      },
      "챕터와 확인 범위": {
        "title": "진행 순서",
        "steps": [
          "기다리는 동안 모제스의 차량 등록, 미용실, 구급차 등 아직 분홍색인 목표를 진행하세요.",
          "목표가 덩크의 연락 대기로 바뀌면 다른 의뢰를 마무리하세요. 전화가 오면 트레일러에서 다음 진통제 임무를 시작할 수 있습니다."
        ]
      },
