  "p09-m-037": {
    "title": "야스마니의 보석 세 점",
    "summary": "야스마니가 원하는 보석 세 점을 모아 판매합니다. 카사 데 엠페뇨의 첫 목걸이를 일찍 전달하면 다른 두 가게에서 쓸 도구를 받습니다.",
    "replaceSections": {
      "보존·마감": {
        "title": "시작 시점과 위치",
        "paragraphs": [
          "부비의 수금 동행 뒤 야스마니가 연락합니다. 두 주인공 모두 시작할 수 있습니다."
        ]
      },
      "챕터와 확인 범위": {
        "title": "진행 순서",
        "steps": [
          "세 매장의 순서는 자유입니다. 뒷문이 없는 카사 데 엠페뇨에서 먼저 목걸이를 가져와 야스마니에게 보여 주면 스냅 건(게임 도구)을 받습니다.",
          "리처드슨 주얼리와 도너번 뱅크스 앤드 컴퍼니에는 새 도구로 열리는 뒷문이 있습니다. 두 매장에서 지정된 장신구가 체크됐는지 확인하세요.",
          "가방에 든 물품을 야스마니에게 팔아야 완료됩니다. 지정품 세 점 합계는 $20,000(현금)이며 추가 전리품은 별도입니다."
        ]
      }
    },
